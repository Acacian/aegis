{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Acacian/aegis",
  "title": "Aegis — AI Agent Governance Runtime",
  "description": "Auto-instrument AI agent frameworks with operational governance. Injection blocking, PII masking, action policy, audit trail. Includes governance API server and transparent MCP proxy.",
  "repository": {
    "url": "https://github.com/Acacian/aegis",
    "source": "github"
  },
  "version": "0.5.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "agent-aegis",
      "version": "0.5.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Path to YAML policy file",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "AEGIS_POLICY_PATH"
        }
      ]
    }
  ]
}
